{
  "hosting": {
    "public": "functions",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "gopath/**",
      "*.zip",
      "*.md",
      "*.txt",
      "firestore.rules",
      "storage.rules",
      "*.san.js",
      "index.js",
      "package.json",
      "package-lock.json"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      }
    ]
